{
  "name": "pixel-office",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @pixel-office/web --",
    "dev:api": "npm run dev --workspace @pixel-office/api",
    "dev:legacy": "node scripts/serve.mjs legacy/pre-alpha",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run validate:assets && npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:assets": "tsx scripts/validate-assets.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
